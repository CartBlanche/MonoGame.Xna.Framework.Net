<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>Microsoft.Xna.Framework</RootNamespace>
    <AssemblyName>MonoGame.Xna.Framework.Net.Android.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <ApplicationId>com.example.mgnet.android.tests</ApplicationId>
    <ApplicationTitle>MonoGame.Xna.Framework.Net.Android.Tests</ApplicationTitle>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Android\MonoGame.Xna.Framework.Net.Android.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NUnitLite" Version="3.13.2" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.7.2" />
    <!-- no PrivateAssets="all": the SDK then leaves the package out of the app, and nothing runs -->
    <PackageReference Include="MonoGame.Framework.Android" Version="3.8.*" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Conformance\BackendConformanceTests.cs" Link="BackendConformanceTests.cs" />
  </ItemGroup>

</Project>
