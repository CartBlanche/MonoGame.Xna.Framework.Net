<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-ios</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>Microsoft.Xna.Framework</RootNamespace>
    <AssemblyName>MonoGame.Xna.Framework.Net.iOS.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <RuntimeIdentifier>iossimulator-arm64</RuntimeIdentifier>
    <ApplicationId>com.example.mgnet.ios.tests</ApplicationId>
    <ApplicationTitle>MonoGame.Xna.Framework.Net.iOS.Tests</ApplicationTitle>
    <ApplicationManifest>Info.plist</ApplicationManifest>
    <!-- MonoGame.Framework.iOS calls OpenAL but its package only links CoreAudio and AudioToolbox -->
    <MtouchExtraArgs>$(MtouchExtraArgs) --gcc_flags="-framework OpenAL"</MtouchExtraArgs>
    <UseInterpreter>true</UseInterpreter>
    <SupportedOSPlatformVersion>18.0</SupportedOSPlatformVersion>
    <!-- the simulator needs at least an ad-hoc signature, or the app is killed at launch (Code Signature Invalid) -->
    <CodesignKey>-</CodesignKey>
  </PropertyGroup>

  <ItemGroup>
    <!-- the trimmer would remove the test fixtures, which nothing references (MtouchLink=None breaks the registrar instead) -->
    <TrimmerRootAssembly Include="MonoGame.Xna.Framework.Net.iOS.Tests" />
    <TrimmerRootAssembly Include="nunit.framework" />
    <TrimmerRootAssembly Include="nunitlite" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\iOS\MonoGame.Xna.Framework.Net.iOS.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NUnit" Version="3.13.2" />
    <PackageReference Include="NUnitLite" Version="3.13.2" />
    <!-- no PrivateAssets="all": the SDK then leaves the package out of the app bundle -->
    <PackageReference Include="MonoGame.Framework.iOS" Version="3.8.*" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Conformance\BackendConformanceTests.cs" Link="BackendConformanceTests.cs" />
  </ItemGroup>

</Project>
