<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A small acceptance test for the data path (SendData / ReceiveData), written against the public XNA-shaped
    API only. It runs as a console app, in one process or across real machines, so it can be pointed at any
    back-end that has been set with NetworkServiceProvider.SetBackend.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DataPath</RootNamespace>
    <AssemblyName>DataPath</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\MonoGame.Xna.Framework.Net.csproj" />
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.*" />
  </ItemGroup>

</Project>
